# Database Management System - Academic Repository
# Specialized .gitignore for database systems and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# DBMS Artifacts (Binary logs, lock files, temp DBs)
# Keep .sql source files, ignore engine-specific binaries
*.db
*.sqlite
*.sqlite3
*.mdb
*.ldb
*.frm
*.ibd
*.myi
*.myd
*.pid

# Java Build Artifacts (JDBC)
*.class
*.jar
*.war
*.ear

# Python Build Artifacts
__pycache__/
*.py[cod]
venv/
env/
.env

# Temporary and Cache files
*.tmp
*.log
.cache/
node_modules/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
